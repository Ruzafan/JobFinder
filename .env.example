# Puerto del servicio web (accesible desde tu red Wi-Fi)
PORT=8000

# IP local de tu PC en la red Wi-Fi (para mostrar el enlace y QR al móvil)
LAN_HOST=192.168.1.149

# Proveedor de IA opcional (también puedes configurarlo desde la web en "Configuración")
# Valores posibles: local, gemini, openai, anthropic, ollama
AI_PROVIDER=local

# Claves API opcionales (puedes dejarlas vacías y configurarlas desde la interfaz web)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

# InfoJobs Developer API opcional (registro gratuito en https://developer.infojobs.net)
INFOJOBS_CLIENT_ID=
INFOJOBS_CLIENT_SECRET=
